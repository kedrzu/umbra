{
  "mcpServers": {
    "gmail": {
      "command": "node",
      "args": ["${PROJECT_ROOT}/mcp-servers/gmail/dist/index.js"],
      "env": {
        "GMAIL_CREDENTIALS_PATH": "${HOME}/.config/umbra/gmail-credentials.json",
        "GMAIL_TOKENS_PATH": "${HOME}/.config/umbra/gmail-tokens.json"
      }
    },
    "calendar": {
      "command": "npx",
      "args": ["-y", "@nspady/google-calendar-mcp"],
      "env": {
        "ENABLED_TOOLS": "list-calendars,list-events,get-event,search-events,list-colors,get-freebusy,get-current-time,create-event,manage-accounts"
      }
    },
    "todoist": {
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    },
    "qmd": {
      "command": "qmd",
      "args": ["mcp"]
    },
    "obsidian-vault": {
      "command": "node",
      "args": ["${PROJECT_ROOT}/mcp-servers/obsidian-vault/dist/index.js"],
      "env": {
        "VAULT_PATH": "/Users/kedrzu/Library/Mobile Documents/iCloud~md~obsidian/Documents/kedrzu",
        "AI_NOTES_PREFIX": "AI/"
      }
    }
  }
}
