{
  "mcpServers": {
    "gmail": {
      "type": "http",
      "url": "http://localhost:${MCP_GMAIL_PORT}/mcp"
    },
    "calendar": {
      "command": "/usr/local/bin/docker",
      "args": ["exec", "-i", "-e", "TRANSPORT=stdio", "umbra-calendar", "node", "build/index.js"]
    },
    "todoist": {
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    },
    "qmd": {
      "command": "${QMD_PATH}",
      "args": ["mcp"],
      "env": {
        "QMD_VAULT_PATH": "${OBSIDIAN_VAULT_PATH}"
      }
    }
  }
}
