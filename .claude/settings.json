{
  "permissions": {
    "allow": [
      "Bash(bun umbra gmail:*)",
      "mcp__calendar__list-calendars",
      "mcp__calendar__list-events",
      "mcp__calendar__get-event",
      "mcp__calendar__search-events",
      "mcp__calendar__list-colors",
      "mcp__calendar__get-freebusy",
      "mcp__calendar__get-current-time",
      "mcp__calendar__manage-accounts",
      "mcp__calendar__create-event",
      "mcp__qmd__*",
      "mcp__obsidian-search__*",
      "mcp__exa__*",
      "Bash(flaneur-ctl:*)",
      "Bash(agent-browser:*)",
      "Read(./obsidian/*)",
      "Edit(./obsidian/*)",
      "Write(./obsidian/*)",
      "Write(/tmp/umbra-invoice-*)",
      "Bash(ls ./obsidian/*)",
      "Bash(cd ./obsidian/*)",
      "Bash(base64 *)",
      "Bash(rm /tmp/umbra-invoice-*)",
      "Bash(python3 scripts/ledger.py:*)",
      "Bash(python3 scripts/todoist.py:*)",
      "mcp__telegram-notify__send_message",
      "mcp__telegram-notify__check"
    ],
    "deny": [
      "Bash(bun umbra gmail auth:*)",
      "Bash(bun umbra secrets run:*)",
      "Bash(bun umbra gmail thread label *TRASH*)",
      "Bash(bun umbra gmail thread label *Trash*)",
      "Bash(bun umbra gmail thread label *trash*)",
      "Bash(bun umbra gmail thread label *SPAM*)",
      "Bash(bun umbra gmail thread label *Spam*)",
      "Bash(bun umbra gmail thread label *spam*)",
      "mcp__calendar__update-event",
      "mcp__calendar__delete-event",
      "mcp__calendar__respond-to-event"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "qmd embed --silent 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "web-search@kedrzu-skills": true,
    "telegram@kedrzu-skills": true,
    "browser@kedrzu-skills": true,
    "skill-improve@kedrzu-skills": true,
    "skill-creator@claude-plugins-official": true,
    "secrets@kedrzu-skills": true,
    "shopping-research@kedrzu-skills": true
  },
  "extraKnownMarketplaces": {
    "kedrzu-skills": {
      "source": {
        "source": "github",
        "repo": "kedrzu/skills"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache/gmail-cli"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "api.todoist.com",
        "*.anthropic.com",
        "*.google.com",
        "*.gstatic.com",
        "*.googleapis.com",
        "*.skyscanner.net",
        "*.skyscanner.pl",
        "*.skyscanner.com",
        "*.booking.com",
        "*.airbnb.pl",
        "*.airbnb.com",
        "*.kayak.pl",
        "*.kayak.com",
        "r.jina.ai",
        "*.ceneo.pl",
        "*.pepper.pl"
      ],
      "allowLocalBinding": false
    },
    "excludedCommands": [
      "qmd"
    ]
  }
}
