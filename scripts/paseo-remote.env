# Konfiguracja zdalnego dostępu do demona Paseo (Tailscale + TLS).
#
# Jedno źródło prawdy dla setup-paseo-remote.sh.
# Po zmianie czegokolwiek tutaj odpal ponownie: ./setup-paseo-remote.sh

# --- Demon ---------------------------------------------------------------
PASEO_DIR="$HOME/.paseo"         # katalog stanu demona (config.json, .env)
PASEO_PORT=6767                  # port, na którym demon nasłuchuje (daemon.listen)

# Hosty, które demon akceptuje w nagłówku Host NIEZALEŻNIE od Tailscale.
# Nazwa MagicDNS jest dopisywana automatycznie z `tailscale status` - nie
# wpisuj jej tutaj na sztywno, bo o to właśnie rozbija się każdy rename.
PASEO_BASE_HOSTNAMES="localhost 127.0.0.1"

# Czy usuwać z allowlisty nieaktualne nazwy *.ts.net (pozostałości po rename).
# 0 = zostaw stare wpisy, 1 = trzymaj tam wyłącznie aktualną nazwę MagicDNS.
PRUNE_STALE_TSNET=1

# --- TLS -----------------------------------------------------------------
# Demon mówi czystym HTTP; HTTPS terminuje `tailscale serve`, używając
# certyfikatu Let's Encrypt wystawionego na nazwę MagicDNS maszyny.
TLS_ENABLED=1

# UWAGA na port 443: Caddy z projektu sigma (/Users/kedrzu/Dev/sigma/.local/Caddyfile,
# auto-generowany) nasłuchuje na *:443, czyli TEŻ na adresach Tailscale. tailscaled
# nie może się wtedy podpiąć ("address already in use") i handshake obsługuje Caddy,
# który nie ma certyfikatu na nazwę MagicDNS -> TLS alert 80 / OSStatus -9847.
# Dlatego Paseo dostaje własny port.
TLS_PORT=8443                    # port HTTPS wystawiany w tailnecie

# --- Hasło ---------------------------------------------------------------
PASSWORD_ENV_KEY="PASEO_PASSWORD" # klucz w $PASEO_DIR/.env
PASSWORD_LENGTH=24                # długość generowanego hasła (--rotate-password)
