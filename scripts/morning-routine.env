# Konfiguracja porannej rutyny asystenta (Paseo schedule + LaunchAgent).
#
# Jedno źródło prawdy dla:
#   - setup-morning-routine.sh        (instalator)
#   - scripts/morning-routine-guard.sh (siatka bezpieczeństwa launchd)
#
# Po zmianie czegokolwiek tutaj odpal ponownie: ./setup-morning-routine.sh

# --- Kiedy ---------------------------------------------------------------
RUN_HOUR=8                       # godzina odpalenia rutyny (0-23, czas lokalny)
RUN_MINUTE=0                     # minuta odpalenia
RUN_DAYS="1-5"                   # dni tygodnia w składni cron (1=pon ... 5=pt, "*" = codziennie)
TIMEZONE="Europe/Warsaw"         # strefa czasowa dla crona Paseo

# Guard (launchd) odpala się dwa razy:
#  - GUARD_PRE_MINUTES przed rutyną: preflight (Docker z serwerami MCP + demon Paseo),
#    żeby o 8:00 agent miał komplet narzędzi - kalendarz chodzi przez `docker exec`,
#    więc kontener MUSI stać, zanim agent wystartuje;
#  - GUARD_DELAY_MINUTES po rutynie: nadrobienie runu, jeśli przepadł
#    (reboot, restart demona, wyłączony Docker).
GUARD_PRE_MINUTES=6
GUARD_DELAY_MINUTES=5

# --- Co ------------------------------------------------------------------
SCHEDULE_NAME="Poranna rutyna asystenta"
PROVIDER="claude"                # paseo provider ls
MODE="bypassPermissions"         # bez tego zaplanowany run pada na pierwszym permission prompt
LAUNCHD_LABEL="com.sigma.morning-routine"

# Prompt dla świeżego agenta. Ostatnie zdanie agenta = treść powiadomienia push na telefon
# (Paseo wysyła pierwsze 220 znaków ostatniej wiadomości), stąd wymóg jednozdaniowego podsumowania.
PROMPT='Poranna rutyna asystenta. Wykonaj skill do-your-job (Skill tool, skill: "do-your-job", args: "unattended").

Tryb w pełni nienadzorowany: nie zadawaj żadnych pytań i nie czekaj na odpowiedź uzytkownika - nikogo nie ma po drugiej stronie. Wszystko, co wymagaloby decyzji, zapisz w sekcji "Do decyzji" w dzisiejszym Dashboardzie.

Ostatnia wiadomosc zacznij od jednego samodzielnego zdania (max 220 znakow) podsumowujacego dzien - to trafia jako tresc powiadomienia push na telefon. Dopiero pod nim daj pelny raport.'

# --- Gdzie ---------------------------------------------------------------
LOG_FILE="/tmp/morning-routine.log"
ERR_FILE="/tmp/morning-routine.err"

# Opcjonalny host demona Paseo (np. "localhost:6767"). Puste = domyślne wykrywanie CLI.
PASEO_HOST=""
