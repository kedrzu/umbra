# Polski głos dla Paseo: Piper w Dockerze za API zgodnym z OpenAI.
#
# Jedno źródło prawdy dla setup-piper-tts.sh i services/piper-tts/compose.yml.
# Po zmianie czegokolwiek tutaj odpal ponownie: ./setup-piper-tts.sh

# --- Głos ----------------------------------------------------------------
# Nazwa i katalog głosu w https://huggingface.co/rhasspy/piper-voices
# Inne polskie: pl_PL-gosia-medium, pl_PL-darkman-medium (zmień też URL).
PIPER_VOICE="pl_PL-mc_speech-medium"
PIPER_VOICE_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main/pl/pl_PL/mc_speech/medium"

# Tempo mowy: >1 wolniej, <1 szybciej (length_scale Pipera).
PIPER_LENGTH_SCALE="1.0"

# Po ilu sekundach bezczynności zwolnić głos z RAM (0 = trzymaj stale).
# Tyle samo czeka lokalny worker mowy Paseo. Ponowne ładowanie trwa ułamek sekundy.
PIPER_IDLE_UNLOAD_SECONDS=300

# --- Serwer --------------------------------------------------------------
PIPER_TTS_PORT=4010              # tylko 127.0.0.1; 4002/4003 zajmują MCP

# --- Paseo ---------------------------------------------------------------
PASEO_DIR="$HOME/.paseo"
# Paseo przyjmuje tylko nazwy OpenAI; serwer i tak mówi jedynym głosem Pipera.
PASEO_TTS_MODEL="tts-1"
PASEO_TTS_VOICE="alloy"
# Klucz jest wymagany przez klienta OpenAI, serwer go nie sprawdza.
PASEO_TTS_API_KEY="piper-local"
