# Konfiguracja publikowania dokumentow (Cloudflare Pages).
#
# Jedno zrodlo prawdy dla:
#   - setup-publishing.sh   (instalator projektu Pages + lustra)
#   - scripts/publish.py    (CLI publikacji)
#
# Po zmianie czegokolwiek tutaj odpal ponownie: ./setup-publishing.sh
#
# Problem, ktory to rozwiazuje: chcesz wrzucic dokument HTML/Markdown albo mala
# statyczna apke do internetu i dostac link do wyslania komus - bez klikania po
# dashboardach i bez osobnej subdomeny na kazdy dokument.

# --- Gdzie to zyje -------------------------------------------------------
# Nazwa projektu Cloudflare Pages JEST subdomena: <PAGES_PROJECT>.pages.dev.
# Musi byc globalnie unikalna w calym Cloudflare - jesli "kedrzu" jest zajete,
# setup przerwie z komunikatem i trzeba tu wpisac inna nazwe (np. kedrzu-docs).
PAGES_PROJECT="kedrzu"
BASE_URL="https://kedrzu.pages.dev"

# --- Lokalne lustro serwisu ----------------------------------------------
# Cloudflare Pages deployuje CALY katalog jako jeden serwis, wiec zrodlem prawdy
# jest katalog lokalny: kazdy dokument to jeden podfolder (slug). Wrangler liczy
# hashe i wysyla tylko brakujace pliki, wiec dorzucenie jednego dokumentu nie
# przeladowuje reszty.
#
# Uklad (STATE_DIR w repo, w .gitignore):
#   published/site/        <- JEDYNY katalog wysylany na Pages
#   published/manifest.json<- lista slugow, zostaje lokalnie
#   published/trash/       <- zdjete dokumenty, zostaja lokalnie
#
# Manifest i kosz sa POZA katalogiem deployu swiadomie: manifest to spis wszystkich
# slugow, a ochrona polega na tym, ze sluga nie da sie zgadnac. Wrzucenie go na serwer
# oddaloby cala liste pod /manifest.json.
#
# UWAGA: katalog jest w .gitignore. Repozytorium kedrzu/umbra jest PUBLICZNE,
# a publikowane tresci bywaja prywatne - nie moga trafic do gita.
STATE_DIR="published"

# --- Adresy dokumentow ------------------------------------------------------
# Skrypt NIE ma polityki nazewnictwa: slug podaje wywolujacy (--slug) i jest brany
# doslownie. Czytelny adres (/garderoba/) dla rzeczy, ktore ktos przepisze z kartki;
# dolosowany sufiks (/wyniki-7f3a91c4/) dla tresci, ktora nie powinna byc do
# zgadniecia. To ocena TRESCI - dlatego zapada wyzej, a nie w konfiguracji.
#
# Niezaleznie od sluga caly serwis ma noindex + robots.txt i nie listuje dokumentow.

# --- Wrangler ------------------------------------------------------------
# Nie instalujemy go na stale - `npx wrangler@<wersja>` wystarcza, a pinowanie
# major wersji chroni przed niespodzianka w CLI przy kolejnym deployu.
WRANGLER_VERSION="4"

# --- Uwierzytelnienie ----------------------------------------------------
# Swiadomie API TOKEN z .env, nie OAuth wranglera: OAuth w tym systemie juz raz
# wygasl po cichu (`Failed to fetch auth token: 400` -> `Not logged in`), a token
# o waskim zakresie (Account -> Cloudflare Pages: Edit) dziala tez w trybie
# unattended, np. w porannej rutynie.
#   .env:  CLOUDFLARE_API_TOKEN=...
#          CLOUDFLARE_ACCOUNT_ID=...
