# Umbra Personal Assistant - Configuration
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# ===================
# Paths
# ===================
# Path to your Obsidian vault (adjust for your system)
# Keep the quotes - the path contains a space and setup scripts `source` this file.
OBSIDIAN_VAULT_PATH="/Users/your-username/Library/Mobile Documents/iCloud~md~obsidian/Documents/your-vault"

# ===================
# Gmail Configuration (Multi-Account)
# ===================
# OAuth 2.0 credentials file (shared for all accounts)
# Download from Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop app)
GMAIL_CREDENTIALS_PATH=${HOME}/.config/umbra/gmail-credentials.json

# Token storage is handled automatically by Docker (named volume: umbra-gmail-tokens)
# Each authenticated account gets its own token file
# Add accounts via: http://localhost:4002/auth
# View accounts via: http://localhost:4002/accounts

# ===================
# Google Calendar Configuration (Multi-Account)
# ===================
# OAuth 2.0 credentials file (shared for all accounts)
# Can use the same Google Cloud project as Gmail, or a separate one
CALENDAR_CREDENTIALS_PATH=${HOME}/.config/umbra/calendar-credentials.json

# Token storage path - Calendar auth must be run on HOST (not in Docker)
# because the auth server only binds to localhost.
# Run: npx @cocal/google-calendar-mcp auth
# Tokens are stored at ~/.config/google-calendar-mcp/tokens.json by default
CALENDAR_TOKENS_PATH=${HOME}/.config/google-calendar-mcp

# ===================
# Todoist (API token - the assistant's ONLY route to Todoist)
# ===================
# There is no Todoist MCP server: scripts/todoist.py talks to the API directly.
# Reads come from a local mirror it keeps (so hundreds of tasks never reach the
# model's context - only a diff does), writes go straight to the API. The script
# has no complete/delete/move commands, so those stay impossible by construction.
# Get it: Todoist -> Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=

# ===================
# MCP Server Ports (can be changed if conflicts exist)
# ===================
MCP_GMAIL_PORT=4002
MCP_CALENDAR_PORT=4003
